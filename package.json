{
  "name": "maylana-booking",
  "private": true,
  "version": "1.0.0-rc.1",
  "type": "module",
  "description": "Web app prenotazioni Maylana Coiffeur (parrucchiere + consulenze Capelli For You)",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "netlify dev",
    "dev:ui": "vite",
    "build": "tsc -b && vite build && node scripts/build-sw.mjs",
    "typecheck": "tsc -b",
    "preview": "vite preview",
    "test:unit": "node --experimental-strip-types --test tests/*.test.ts",
    "test:db": "psql \"$DATABASE_URL\" -X -v ON_ERROR_STOP=1 -f supabase/tests/db_tests.sql",
    "test:security": "psql \"$DATABASE_URL\" -X -v ON_ERROR_STOP=1 -f supabase/tests/security_audit.sql",
    "test:concurrency": "bash scripts/test-concurrency.sh",
    "test:integration": "bash tests/integration/run.sh integration",
    "test:e2e": "bash tests/integration/run.sh e2e",
    "verify": "npm run typecheck && npm run test:unit && npm run build",
    "icons": "node scripts/generate-icons.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.50.0",
    "openai": "^7.4.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@netlify/functions": "^3.0.0",
    "@tailwindcss/vite": "^4.1.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "playwright": "^1.56.0",
    "sharp": "^0.34.0",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.20.0",
    "typescript": "~5.9.0",
    "vite": "^7.1.0"
  }
}
