# =====================================================================
# Maylana Coiffeur Booking — variabili d'ambiente
# Copia in ".env" per lo sviluppo locale. In produzione impostale su
# Netlify: Site configuration → Environment variables.
# =====================================================================

# ---- Browser (finiscono nel bundle pubblico: SOLO valori pubblici) ----
# URL del progetto Supabase (Project Settings → API)
VITE_SUPABASE_URL=https://TUO-PROGETTO.supabase.co
# Chiave pubblica: "anon" (legacy) oppure "publishable" (sb_publishable_…)
# Serve solo per il login dell'area /admin. I dati sono protetti dalla RLS.
VITE_SUPABASE_ANON_KEY=

# ---- Server (solo Netlify Functions — MAI con prefisso VITE_) ----
SUPABASE_URL=https://TUO-PROGETTO.supabase.co
# Chiave "service_role" (legacy) oppure "secret" (sb_secret_…). SEGRETA.
SUPABASE_SERVICE_ROLE_KEY=
# Stringa casuale lunga (min 16 caratteri) per anonimizzare IP e telefoni
# nel rate limiting. Generala con:  openssl rand -hex 32
RATE_LIMIT_SALT=
# URL pubblico della web app (usato nei link delle email), es.
# https://prenota.TUO-DOMINIO.it — se vuoto si usa l'URL Netlify.
PUBLIC_SITE_URL=
# Origini aggiuntive autorizzate (separate da virgola), es. dominio personalizzato.
ALLOWED_ORIGINS=

# ---- Email transazionali (server) ----
# Provider: "resend" oppure "brevo". Se vuoto, NESSUNA email viene inviata:
# gli invii risultano "non inviati" e la dashboard mostra l'errore.
EMAIL_PROVIDER=
# Chiave API del provider (Resend: re_…, Brevo: xkeysib-…). SEGRETA.
EMAIL_API_KEY=
# Mittente verificato presso il provider (dominio con SPF/DKIM configurati)
EMAIL_FROM="Maylana Coiffeur <prenotazioni@TUODOMINIO.it>"
# Indirizzo a cui arrivano le risposte dei clienti (facoltativo)
EMAIL_REPLY_TO=

# ---- Solo per i test da terminale (progetto Supabase di TEST) ----
# DATABASE_URL=postgresql://postgres:PASSWORD@db.TUO-PROGETTO.supabase.co:5432/postgres

# ---- WhatsApp Business Platform (Cloud API) — MODULO DISATTIVATO ----
# I pulsanti WhatsApp dell'app usano semplici link wa.me: aprono WhatsApp
# con un testo precompilato e l'invio lo fa una persona. NON sono notifiche
# automatiche. Il numero del salone si imposta in dashboard → Impostazioni.
#
# Il modulo ufficiale Cloud API resta spento finché TUTTE queste variabili
# non sono impostate e WHATSAPP_CLOUD_ENABLED=true. Richiede: account
# WhatsApp Business verificato su Meta, numero registrato, modelli (template)
# approvati, consenso del cliente. Nessun invio è ancora collegato ai flussi.
WHATSAPP_CLOUD_ENABLED=false
WHATSAPP_PHONE_NUMBER_ID=
# Token di accesso permanente (System User). SEGRETO.
WHATSAPP_ACCESS_TOKEN=
# App secret per verificare la firma dei webhook. SEGRETO.
WHATSAPP_APP_SECRET=
# Stringa scelta da te per la verifica del webhook (/api/whatsapp/webhook)
WHATSAPP_VERIFY_TOKEN=
# Mappa JSON dei modelli approvati, es. {"reminder":{"name":"promemoria_appuntamento","language":"it"}}
WHATSAPP_TEMPLATES=
WHATSAPP_GRAPH_VERSION=v21.0

# ---- Maylana AI (OpenAI, SOLO server) ----
# L'assistente compare ai clienti solo se: AI_ENABLED=true, chiave e modello
# impostati, E attivazione in dashboard → Maylana AI. Altrimenti la pagina
# di prenotazione funziona esattamente come prima.
AI_ENABLED=false
# Chiave segreta OpenAI (platform.openai.com → API keys). SEGRETA: mai con prefisso VITE_.
OPENAI_API_KEY=
# Modello (modificabile senza toccare il codice). Scegli un modello piccolo ed
# economico adatto a conversazioni brevi con chiamata di funzioni; verifica nome
# e prezzo sul listino OpenAI al momento dell'attivazione.
OPENAI_MODEL=
# Facoltativi:
# AI_TIMEOUT_MS=8000            timeout di ogni chiamata a OpenAI
# AI_DEADLINE_MS=9000           tempo massimo di un turno (limite funzioni Netlify)
# OPENAI_REASONING_EFFORT=low   solo per modelli con ragionamento: minimal|low|medium
# OPENAI_INCLUDE_REASONING=true false se il modello non supporta reasoning.encrypted_content
# AI_SESSION_SECRET=            segreto per firmare la cronologia (min 16 caratteri; default derivato da RATE_LIMIT_SALT)
